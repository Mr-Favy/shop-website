# Required for the storefront API, database reads/writes, and checkout.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key

# Optional: enables order confirmation email.
MAILGUN_DOMAIN=mg.example.com
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_FROM="Zamac Füds <orders@mg.example.com>"

# Optional: enables training instalment payments via Paystack.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PUBLIC_BASE_URL=https://your-production-domain.example
PAYSTACK_CALLBACK_URL=

# Optional: defaults to 8000.
PORT=8000
